# Sanity
NUXT_SANITY_PROJECT_ID=
# Write token for seed script and contact form API (server-only, never shipped to the client)
SANITY_TOKEN=
# Optional explicit runtime token for production (maps to runtimeConfig.sanityWriteToken)
NUXT_SANITY_WRITE_TOKEN=

# On-demand ISR revalidation (production only — see docs/DEPLOYMENT.md).
# Shared secret the Sanity webhook must send as `Authorization: Bearer <value>`.
NUXT_REVALIDATE_SECRET=
# Vercel prerender bypass token. Must be set at BUILD time on Vercel (it's baked
# into the ISR config). Any long random string.
NUXT_REVALIDATE_TOKEN=
